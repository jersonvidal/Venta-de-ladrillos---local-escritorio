	public void actionPerformed(ActionEvent e) {
		if (e.getSource() == btnCerrar) {
			actionPerformedBtnCerrar(e);
		}
		if(e.getSource() == cboModelo) {
			actionPerformedCboModelo(e);
		}
	}
	protected void actionPerformedBtnCerrar(ActionEvent e) {
		System.exit(0);
	}
	protected void actionPerformedCboModelo(ActionEvent e) {
		int mod;
		mod = leerModelo();
		switch(mod) {
		case 0: 
			mostrarLadrillo(Tienda1.precio0, Tienda1.ancho0, Tienda1.largo0, Tienda1.espesor0, Tienda1.cantidadOptima0);
			break;
		case 1:
			mostrarLadrillo(Tienda1.precio1, Tienda1.ancho1, Tienda1.largo1, Tienda1.espesor1, Tienda1.cantidadOptima1);
			break;
		case 2:
			mostrarLadrillo(Tienda1.precio2, Tienda1.ancho2, Tienda1.largo2, Tienda1.espesor2, Tienda1.cantidadOptima2);
             break;
		case 3:
			mostrarLadrillo(Tienda1.precio3, Tienda1.ancho3, Tienda1.largo3, Tienda1.espesor3, Tienda1.cantidadOptima3);
            break;
         default:
 			mostrarLadrillo(Tienda1.precio4, Tienda1.ancho4, Tienda1.largo4, Tienda1.espesor4, Tienda1.cantidadOptima4);
	}
   }
	int leerModelo() {
		return cboModelo.getSelectedIndex();

	}  

	void mostrarLadrillo(double pre, double anc, double lar, double esp, int cano) {
		txtPrecio.setText(pre + "");
		txtAncho.setText(anc + "");
		txtLargo.setText(lar + "");
		txtEspesor.setText(esp + "");
		txtCanOptima.setText(cano + "");
	}
