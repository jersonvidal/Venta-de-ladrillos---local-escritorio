	public void actionPerformed(ActionEvent e) {
		if (e.getSource() == btnCerrar) {
			actionPerformedBtnCerrar(e);
		}
		if(e.getSource() == cboModelo) {
			actionPerformedCboModelo(e);
		}
		if(e.getSource() == btnVender) {
			actionPerformedBtnVender(e);
		}
	}
	protected void actionPerformedBtnCerrar(ActionEvent e) {
		System.exit(0);
	}
	
	 protected void actionPerformedCboModelo(ActionEvent e) {
			
			int mod;
			mod = leerModelo();
			switch(mod) {
			case 0: 
				mostrarLadrillo(Tienda1.precio0); break;
			case 1:
				mostrarLadrillo(Tienda1.precio1); break; 
			case 2:
				mostrarLadrillo(Tienda1.precio2); break;
			case 3:
				mostrarLadrillo(Tienda1.precio3); break;
				default: 
					mostrarLadrillo(Tienda1.precio4);
			}
	 }
	 int leerModelo() {
		 return cboModelo.getSelectedIndex();
	 }
	 void mostrarLadrillo(double pre) {
			txtPrecio.setText("" + pre);
			}
	 
	 protected void actionPerformedBtnVender(ActionEvent e) {
		 int can, mod, cano;
		 double icom, ides, ipag;
		 mod = leerModelo();
		 can = leerCantidad();
		 icom = importeCompra(mod, can);
		 ides = importeDescuento(can, icom);
		 ipag = importePagar(icom, ides);
		 cano = calcularObsequio(can);
		switch(mod) {
		case 0: mostrarDatos(Tienda1.modelo0, Tienda1.precio0, icom, ides, ipag, cano, Tienda1.tipoObsequio); break;
		case 1: mostrarDatos(Tienda1.modelo1, Tienda1.precio1, icom, ides, ipag, cano, Tienda1.tipoObsequio); break;
		case 2: mostrarDatos(Tienda1.modelo2, Tienda1.precio2, icom, ides, ipag, cano, Tienda1.tipoObsequio); break;
		case 3: mostrarDatos(Tienda1.modelo3, Tienda1.precio3, icom, ides, ipag, cano, Tienda1.tipoObsequio); break;
		default: mostrarDatos(Tienda1.modelo4, Tienda1.precio4, icom, ides, ipag, cano, Tienda1.tipoObsequio); break;
		}
		
	 }
	 int leerCantidad() {
		 return Integer.parseInt(txtCantidad.getText());
	 }
	 double importeCompra(int m, int c) {
		 switch(m) {
		 case 0: return Tienda1.precio0 * c;
		 case 1: return Tienda1.precio1 * c;
		 case 2: return Tienda1.precio2 * c;
		 case 3: return Tienda1.precio3 * c;
		default: return Tienda1.precio4 * c;

		 }
	 }
	 double importeDescuento(int c, double ic) {
		 if (c<5) {
			 return Tienda1.porcentaje1 * ic;
		 }
		 else if(c<10) {
			 return Tienda1.porcentaje2 * ic;
		 }
		 else if(c<15) {
			 return Tienda1.porcentaje3 * ic;
		 }
		 else if (c<20) {
			 return Tienda1.porcentaje4 * ic;
		 }
		 else return Tienda1.porcentaje5 * ic;
	 }
	 double importePagar(double ic, double id) {
		 return ic - id;	 
	 }
	 int calcularObsequio(int c) {
		 if(c<5) {
			 return Tienda1.obsequioCantidad1;
		 }
		 else if(c<10) {
			 return Tienda1.obsequioCantidad2;
		 }
		 else if(c<15) {
			 return Tienda1.obsequioCantidad3;
		 }
		 else if(c<20) {
			 return Tienda1.obsequioCantidad4;
		 }
		 else return Tienda1.obsequioCantidad5;
	 }
	 void mostrarDatos(String mod, double pre, double icom, double ides, double ipag, int cano, String tipo) {
		    textArea.setText("BOLETA DE VENTA" + "\n" + "\n");
			textArea.append("Modelo              :" + mod + "\n");
			textArea.append("Precio por millar   :" + pre + "\n");
			textArea.append("Importe compra      :" + icom + "\n");
			textArea.append("Importe descuento   :" + ides + "\n");
			textArea.append("Importa a pagar     :" + ipag + "\n");
			textArea.append("Precio por millar   :" + tipo + "\n");
			textArea.append("Unidades a obsequiar:" + cano + "\n");
			}
	
