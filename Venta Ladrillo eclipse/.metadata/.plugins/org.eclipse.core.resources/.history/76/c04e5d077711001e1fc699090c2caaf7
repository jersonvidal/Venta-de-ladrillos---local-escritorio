	protected void actionPerformedCboModelo(ActionEvent e) {
		int mod;
		mod = leerModelo();
		switch(mod) {
		case 0: 
			mostrarLadrillo(Tienda1.precio0, Tienda1.ancho0, Tienda1.largo0, Tienda1.espesor0, Tienda1.cantidadOptima0);
			break;
		case 1:
			mostrarLadrillo(Tienda1.precio1, Tienda1.ancho1, Tienda1.largo1, Tienda1.espesor1, Tienda1.cantidadOptima1);
			break;
		case 2:
			mostrarLadrillo(Tienda1.precio2, Tienda1.ancho2, Tienda1.largo2, Tienda1.espesor2, Tienda1.cantidadOptima2);
             break;
		case 3:
			mostrarLadrillo(Tienda1.precio3, Tienda1.ancho3, Tienda1.largo3, Tienda1.espesor3, Tienda1.cantidadOptima3);
            break;
         default:
 			mostrarLadrillo(Tienda1.precio4, Tienda1.ancho4, Tienda1.largo4, Tienda1.espesor4, Tienda1.cantidadOptima4);
	}
   }
	int leerModelo() {
		return cboModelo.getSelectedIndex();

	}  

	void mostrarLadrillo(double pre, double anc, double lar, double esp, int cano) {
		txtPrecio.setText(pre + "");
		txtAncho.setText(anc + "");
		txtLargo.setText(lar + "");
		txtEspesor.setText(esp + "");
		txtCanOptima.setText(cano + "");
	}
	
	protected void actionPerformedBtnGrabar(ActionEvent e) {
		double pre, anc, lar, esp;
		int cano, mod;
		mod = leerModelo();
		pre = leerPrecio();
		anc = leerAncho();
		lar = leerLargo();
		esp = leerEspesor();
		cano = leerCano();
		
		if (pre < 0) {
			JOptionPane.showMessageDialog(this, "Precio mínimo debe ser mayor que 0");
			txtPrecio.requestFocus();
			txtPrecio.selectAll();
		} else if (anc < 0) {
			JOptionPane.showMessageDialog(this, "Ancho mínimo debe ser mayor que 0 cm");
			txtAncho.requestFocus();
			txtAncho.selectAll();
		} else if (lar < 0) {
			JOptionPane.showMessageDialog(this, "Largo mínimo debe ser mayor que 0 cm ");
			txtLargo.requestFocus();
			txtLargo.selectAll();
		} else if (esp < 0) {
			JOptionPane.showMessageDialog(this, "Espesor mínimo debe ser mayor que 0 mm");
			txtEspesor.requestFocus();
			txtEspesor.selectAll();
		} else if (cano < 0) {
			JOptionPane.showMessageDialog(this, "Cantidad óptima debe ser mayor que 0");
			txtCanOptima.requestFocus();
			txtCanOptima.selectAll();
		} else {
			modificarInformacionLadrillo(mod, pre, anc, lar, esp, cano);
			dispose();
		}
	}
	
	double leerPrecio() {
		return Double.parseDouble(txtPrecio.getText());

	}  

	double leerAncho() {
		return Double.parseDouble(txtAncho.getText());

	}  

	double leerLargo() {
		return Double.parseDouble(txtLargo.getText());

	}  

	double leerEspesor() {
		return Double.parseDouble(txtEspesor.getText());

	}  

	int leerCano() {
		return Integer.parseInt(txtCanOptima.getText());

	}
	
	void modificarInformacionLadrillo(int mod, double pre, double anc, double lar, double esp, int cano) {
		switch(mod) {
		case 0: 
			Tienda1.precio0 = pre;
			Tienda1.ancho0 = anc;
			Tienda1.largo0 = lar;
			Tienda1.espesor0 = esp;
			Tienda1.cantidadOptima0 = cano;
			break;
		case 1:
			Tienda1.precio1 = pre;
			Tienda1.ancho1 = anc;
			Tienda1.largo1 = lar;
			Tienda1.espesor1 = esp;
			Tienda1.cantidadOptima1 = cano;
			break;
		case 2:
			Tienda1.precio2 = pre;
			Tienda1.ancho2 = anc;
			Tienda1.largo2 = lar;
			Tienda1.espesor2 = esp;
			Tienda1.cantidadOptima2 = cano;
             break;
		case 3:
			Tienda1.precio3 = pre;
			Tienda1.ancho3 = anc;
			Tienda1.largo3 = lar;
			Tienda1.espesor3 = esp;
			Tienda1.cantidadOptima3 = cano;
            break;
         default:
        	Tienda1.precio4 = pre;
 			Tienda1.ancho4 = anc;
 			Tienda1.largo4 = lar;
 			Tienda1.espesor4 = esp;
 			Tienda1.cantidadOptima4 = cano;
 			break;
		}
	}


